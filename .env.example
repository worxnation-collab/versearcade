# Copy to `.env.local` and fill in. Vite only exposes vars prefixed with VITE_.
# The app runs in a fully-functional LOCAL/OFFLINE mode if these are blank,
# so you can play the daily loop before wiring Supabase.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: the OAuth redirect used by Google/Apple sign-in on web.
# For iOS the Capacitor deep link is handled separately (see docs/SETUP-APPLE.md).
VITE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback

# Active Bible translation (must exist in src/lib/config.ts TRANSLATIONS).
# Public-domain default is the Berean Standard Bible.
VITE_DEFAULT_TRANSLATION=BSB
