# Copy to `.env.local` and fill in. Vite only exposes vars prefixed with VITE_.
# The app runs in a fully-functional LOCAL/OFFLINE mode if these are blank,
# so you can play the daily loop before wiring Supabase.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: the OAuth redirect used by Google/Apple sign-in on web.
# For iOS the Capacitor deep link is handled separately (see docs/SETUP-APPLE.md).
VITE_AUTH_REDIRECT_URL=http://localhost:5173/auth/callback
# Where a NATIVE (App Store / Play) sign-in lands when the provider is done: an
# https page on the site that hands the session on to the app (public/auth/native).
# Default is the live site; only set this to point a test build at a preview deploy.
# VITE_NATIVE_AUTH_BRIDGE_URL=https://versearcade.org/auth/native/

# Active Bible translation (must exist in src/lib/config.ts TRANSLATIONS).
# Public-domain default is the Berean Standard Bible.
VITE_DEFAULT_TRANSLATION=BSB

# ── Apple in-app purchase (native builds only) ───────────────────────────────
# RevenueCat's PUBLIC iOS SDK key ("appl_..."). Drives the App Store purchase
# flow in src/lib/iap.ts. The web build ignores it entirely — the site sells
# through Stripe Payment Links, the app must sell through Apple (Guideline
# 3.1.1). Leave blank and the app simply shows no storefront, which is the
# compliant fallback; it never shows a price it can't charge.
VITE_REVENUECAT_IOS_KEY=
# "on" lets the App Store build show a "View plans and billing" link out to the
# web church pages — on the US storefront ONLY (lib/commerce churchPlansLink).
# Anything else, or a storefront the SDK can't read, shows the inquiry path.
# VITE_CHURCH_PLANS_US_LINK=on

# ── Scripture in other translations (API.Bible) ──────────────────────────────
# NOT a client variable, on purpose: there is no VITE_ key for API.Bible. The
# key lives server-side with the `bible-text` Edge Function — as the function
# secret API_BIBLE_API_KEY, or in Vault under that name (migration 0125) —
# because anything VITE_ is compiled into the bundle the iOS app ships. With no
# Supabase keys above, the app reads the public-domain versions from
# bible-api.com and the bundled BSB, and offers only those.
