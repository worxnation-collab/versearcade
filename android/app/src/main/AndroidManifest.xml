<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- OAuth deep link: system browser returns Google/Apple sign-in to the
                 app via com.versearcade.app://auth/callback. Capacitor's App plugin
                 fires 'appUrlOpen', handled in src/lib/native.ts (same as iOS). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.versearcade.app" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Church tab: a one-shot coarse fix so we can look up churches near the
         player. Never stored, never tracked in the background — fine location
         is declared only because some devices report nothing without it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- @capacitor/local-notifications declares SCHEDULE_EXACT_ALARM in its own
         manifest, and the merger would pull it into ours. We remove it on
         purpose, for two reasons:

         1. Play policy. Exact alarms are a restricted permission reserved for
            alarm-clock, timer and calendar apps. A daily verse nudge is none of
            those, so declaring it invites a rejection (or a declaration form we
            can't honestly fill in) for a precision we don't need.
         2. UX. The plugin's default is isExactNotification:true, and on Android
            12+ that makes schedule() launch the system "Alarms & reminders"
            settings screen. applyPlan() runs on every app resume, so a player
            would be thrown out of the app to a settings page. lib/reminders.ts
            passes isExactNotification:false to match this — change one, change
            the other, or the nudges start yanking people out of the app.

         The cost is that a reminder may fire a few minutes late. For "your
         study is calling" that is not a cost at all. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        tools:node="remove" />
</manifest>
