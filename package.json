{
  "name": "verse-arcade",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Verse Arcade \u2014 make opening the Bible feel exciting and habitual.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:pool && npm run check:structure && tsc -b && vite build",
    "check:pool": "node scripts/check-pool.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "ios:add": "cap add ios",
    "cap:android": "cap open android",
    "android:add": "cap add android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@revenuecat/purchases-capacitor": "^13.4.2",
    "@supabase/supabase-js": "^2.45.0",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
