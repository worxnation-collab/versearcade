{
  "name": "verse-arcade",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Verse Arcade — make opening the Bible feel exciting and habitual.",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:pool && npm run check:structure && npm run check:cross && npm run check:placement && npm run check:decor && npm run check:map && tsc -b && vite build",
    "check:pool": "node scripts/check-pool.mjs",
    "check:cross": "node scripts/check-cross.mjs",
    "check:decor": "node scripts/check-decor-art.mjs",
    "check:map": "node scripts/check-map.mjs",
    "check:placement": "node scripts/check-placement.mjs",
    "check:structure": "node scripts/check-structure.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "ios:add": "cap add ios"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.0",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.1.0",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/preferences": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@revenuecat/purchases-capacitor": "^9.2.2",
    "@supabase/supabase-js": "^2.45.0",
    "canvas-confetti": "^1.9.3",
    "framer-motion": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.0",
    "@capacitor/ios": "^6.1.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.0"
  }
}
